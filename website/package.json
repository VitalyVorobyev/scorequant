{
  "name": "@scorequant/learning-portal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20",
    "pnpm": "11.0.9"
  },
  "scripts": {
    "start": "pnpm generate && docusaurus start",
    "generate": "pnpm generate:protocol && pnpm generate:data && pnpm generate:atlas && pnpm generate:showcase && pnpm generate:walkthroughs && pnpm generate:snippets",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "generate:data": "cd .. && uv run python website/scripts/generate_data.py",
    "generate:atlas": "cd .. && uv run python website/scripts/generate_atlas.py",
    "generate:snippets": "cd .. && uv run python website/scripts/generate_snippets.py",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "assemble:site": "node scripts/assemble-site.mjs",
    "build:site": "docusaurus build",
    "build:content": "pnpm generate && pnpm build:site && pagefind --site build",
    "build": "pnpm prepare:runtime && pnpm build:content",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "pnpm generate && pnpm typecheck && pnpm lint && pnpm test && pnpm build:site",
    "generate:showcase": "cd .. && uv run python website/scripts/generate_showcase.py",
    "generate:walkthroughs": "cd .. && uv run python website/scripts/generate_walkthroughs.py"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "katex": "^0.18.5",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "16.0.0",
    "pagefind": "1.5.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "4.1.11",
    "webpack": "5.110.0"
  }
}
